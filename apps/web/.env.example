# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Set these on the Convex deployment, not here (npx convex env set NAME value):
#   CLERK_JWT_ISSUER_DOMAIN  issuer of the Clerk "convex" JWT template
#   LL_ENGINE_URL            where the finance engine runs, e.g. http://localhost:8000
#   LL_ENGINE_SECRET         same value as the engine's LL_ENGINE_SECRET
#   LL_TOKEN_KEY             base64 of 32 random bytes; encrypts Xero tokens at rest
#   XERO_WEBHOOK_KEY         from the Xero app's webhook settings
#   SITE_URL                 this web app's URL, e.g. http://localhost:3000
