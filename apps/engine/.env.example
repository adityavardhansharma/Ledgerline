# Shared with Convex (LL_ENGINE_SECRET there). Generate with: openssl rand -hex 32
LL_ENGINE_SECRET=
# Only for local development without Convex signing.
LL_ALLOW_UNSIGNED=false

# Xero app: https://developer.xero.com/app/manage
LL_XERO_CLIENT_ID=
LL_XERO_CLIENT_SECRET=

# Optional: board-pack commentary
LL_OPENROUTER_API_KEY=
LL_OPENROUTER_MODEL=openai/gpt-5.6-luna
